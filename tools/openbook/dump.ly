% Event dumper: logs every note, rest, tie and key change the engravers see, exactly as LilyPond understood them.
#(define dump-port (open-output-file dump-file-name))
#(define (rat->str r) (format #f "~a/~a" (numerator r) (denominator r)))
#(define (mom->str m) (format #f "~a/~a" (ly:moment-main-numerator m) (ly:moment-main-denominator m)))
#(define (grace-str m) (format #f "~a/~a" (ly:moment-grace-numerator m) (ly:moment-grace-denominator m)))
#(define (pitch->str p)
   (format #f "~a ~a ~a" (ly:pitch-notename p) (rat->str (ly:pitch-alteration p)) (ly:pitch-octave p)))
#(define (dur->str d)
   (format #f "~a ~a ~a" (ly:duration-log d) (ly:duration-dot-count d) (rat->str (ly:duration-scale d))))
#(define (make-dumper tag)
   (lambda (context)
     (let ((evs '()) (tie #f))
       (make-engraver
        (listeners
         ((note-event engraver event) (set! evs (cons (cons 'N event) evs)))
         ((rest-event engraver event) (set! evs (cons (cons 'R event) evs)))
         ((skip-event engraver event) #f)
         ((multi-measure-rest-event engraver event) (set! evs (cons (cons 'MR event) evs)))
         ((tie-event engraver event) (set! tie #t))
         ((key-change-event engraver event)
          (let ((tonic (ly:event-property event 'tonic))
                (alist (ly:event-property event 'pitch-alist)))
            (format dump-port "~a K ~a ~a ~a\n" tag
                    (mom->str (ly:context-current-moment context))
                    (pitch->str tonic)
                    (string-join (map (lambda (pr) (format #f "~a:~a" (car pr) (rat->str (cdr pr)))) alist) ","))))
         ((time-signature-event engraver event)
          (format dump-port "~a T ~a ~a/~a\n" tag (mom->str (ly:context-current-moment context))
                  (ly:event-property event 'numerator) (ly:event-property event 'denominator))))
        ((process-music engraver)
         (if (pair? evs)
             (let* ((now (ly:context-current-moment context))
                    (bar (ly:context-property context 'currentBarNumber))
                    (pos (ly:context-property context 'measurePosition)))
               (for-each
                (lambda (pr)
                  (let* ((e (cdr pr))
                         (d (ly:event-property e 'duration))
                         (p (ly:event-property e 'pitch #f)))
                    (format dump-port "~a ~a ~a ~a ~a ~a | ~a | ~a | ~a ~a ~a\n"
                            tag (car pr) (mom->str now) (grace-str now) bar (mom->str pos)
                            (if (ly:duration? d) (dur->str d) "- - -")
                            (if (ly:pitch? p) (pitch->str p) "- - -")
                            (if (eq? #t (ly:event-property e 'bass #f)) "bass" "-")
                            (if (eq? #t (ly:event-property e 'inversion #f)) "inv" "-")
                            (if tie "tie" "-"))))
                (reverse evs)))))
        ((stop-translation-timestep engraver) (set! evs '()) (set! tie #f))))))
